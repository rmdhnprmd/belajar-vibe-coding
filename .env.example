# ============================================================
# Contoh konfigurasi environment.
# Copy file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# ============================================================

# Server
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vibe_coding

# Opsional: URI koneksi lengkap.
# Jika diisi, nilainya MENGGANTIKAN DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/vibe_coding
